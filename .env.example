# Agent model (OpenAI-compatible endpoint; base URL normally includes /v1)
FINGROUND_MODEL=deepseek/deepseek-v4-flash
FINGROUND_MODEL_BASE_URL=https://llm.example.com/v1
FINGROUND_MODEL_API_KEY=replace-with-model-api-key

# PDF OCR service (base URL must not include /v1/chat/completions)
FINGROUND_OCR_BASE_URL=https://ocr.example.com
FINGROUND_OCR_MODEL=Unlimited-OCR
FINGROUND_OCR_API_KEY=

# Optional OCR tuning
FINGROUND_OCR_TIMEOUT_SECONDS=180
FINGROUND_OCR_MAX_PAGES=500
FINGROUND_OCR_BATCH_PAGES=20
FINGROUND_OCR_MAX_PARALLEL_PAGES=8
FINGROUND_OCR_RENDER_DPI=144
FINGROUND_OCR_CACHE_VERSION=v1
FINGROUND_OCR_TRUST_ENV=false
