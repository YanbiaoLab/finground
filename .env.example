# Agent model (required; base URL normally includes /v1)
FINGROUND_MODEL=
FINGROUND_MODEL_BASE_URL=
FINGROUND_MODEL_API_KEY=

# PDF OCR service (required when uploading PDFs; optional for Markdown-only use)
# The base URL must not include /v1/chat/completions.
FINGROUND_OCR_BASE_URL=
FINGROUND_OCR_MODEL=
FINGROUND_OCR_API_KEY=

# Optional OCR tuning
FINGROUND_OCR_TIMEOUT_SECONDS=180
FINGROUND_OCR_MAX_PAGES=500
FINGROUND_OCR_BATCH_PAGES=20
FINGROUND_OCR_MAX_PARALLEL_PAGES=8
FINGROUND_OCR_RENDER_DPI=144
FINGROUND_OCR_CACHE_VERSION=v1
FINGROUND_OCR_TRUST_ENV=false
